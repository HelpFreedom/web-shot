{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Web Shot",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "homepage_url": "https://github.com/HelpFreedom/web-shot",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
